# Where the app keeps its data on the server (media/, media/avatars/, db.sqlite, x_session.db)
DATA_PATH=/path/to/apps/ScrewXBookmarks

# Your X account. Cookies come from a logged-in browser: devtools -> Storage -> Cookies -> https://x.com
# Only auth_token and ct0 are required. Treat these like a password.
X_USERNAME=your_handle
X_COOKIES="auth_token=...; ct0=..."

# Local hours (per TZ) when scheduled syncs won't start. Empty to disable.
QUIET_HOURS=1-8
TZ=UTC

PORT=8080
PUID=1000
PGID=1000
